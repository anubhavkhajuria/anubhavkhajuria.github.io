    <template id="chip-template">
        <div class="sim sim-chip" aria-label="An animated 2.5D and 3D chiplet package">
            <div class="sim-topline"><span>ADVANCED PACKAGING / HETEROGENEOUS COMPUTE</span><span class="sim-live"><i></i> LINK ACTIVE</span></div>
            <div class="package-scene"><div class="package-side-label">3D STACK</div><div class="package-stack">
                <div class="stack-chip stack-hbm"><span>HBM</span><small>memory</small></div><div class="stack-chip stack-cache"><span>CACHE</span><small>vertical link</small></div><div class="stack-chip stack-compute"><span>COMPUTE</span><small>chiplet A</small></div>
            </div><div class="package-interposer"><div class="interposer-die die-cpu"><span>CPU</span><small>control</small></div><div class="interposer-die die-gpu"><span>GPU</span><small>compute</small></div><div class="interposer-die die-io"><span>I/O</span><small>connect</small></div><div class="interposer-wire wire-a"></div><div class="interposer-wire wire-b"></div><div class="interposer-wire wire-c"></div><span class="interposer-label">2.5D INTERPOSER</span></div><div class="package-side-label">DATA / POWER / THERMALS</div></div>
            <div class="sim-caption"><span>Keep compute close to the data.</span><span>2.5D interposer + 3D stacking</span></div>
        </div>
    </template>

    <script src="/site.js" is:inline></script>
</body>
</html>
